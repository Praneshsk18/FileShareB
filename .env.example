# Database (Supabase PostgreSQL pooler or Railway Postgres)
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=your_database_password
DB_DRIVER=org.postgresql.Driver

# Backblaze B2 / AWS S3 Storage
B2_BUCKET_NAME=your-bucket-name
B2_ENDPOINT=https://s3.ca-east-006.backblazeb2.com
B2_REGION=ca-east-006
B2_KEY_ID=your_backblaze_key_id
B2_APPLICATION_KEY=your_backblaze_application_key

# JWT Security
# Generate a strong 256-bit secret key (e.g., openssl rand -hex 32)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated list of frontend domains, e.g. your Vercel/Netlify URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app

# Optional Production Overrides
SWAGGER_ENABLED=true
SPRING_JPA_SHOW_SQL=false
